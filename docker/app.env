# Container configuration for the app service.
#
# This is mounted over platform/.env, because the host copy points at
# 127.0.0.1 (correct when running on the host, wrong inside the network).
#
# It deliberately replaces docker-compose's `environment:` block. Variables set
# there land in $_SERVER, and Laravel's env repository reads $_SERVER before
# $_ENV — while PHPUnit's <env force="true"> only writes putenv() and $_ENV.
# The result was that phpunit.xml could not override compose, and the suite ran
# at APP_ENV=local against the development database. Config belongs in one
# place; this is it.

APP_NAME="Support Academy"
APP_ENV=local
APP_KEY=base64:5C97YryzdFbCuj/iKEHj98TzWi6FbNfmYQoHTXoqlMA=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pilot_lms
DB_USERNAME=pilot
DB_PASSWORD=pilot_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DRIVER=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="training@pilot.test"
MAIL_FROM_NAME="${APP_NAME}"
