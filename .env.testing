# Laravel loads this file *instead of* .env when APP_ENV=testing — not in
# addition to it. Anything the application needs to boot has to be here, which
# is why APP_KEY appears below: without it, every test that touches an
# encrypted session dies with MissingAppKeyException.
#
# A fixed, throwaway key. It only ever encrypts data that exists for the
# duration of one test run, and committing it keeps the suite runnable from a
# fresh clone with no setup step.

APP_NAME="Support Training Hub"
APP_ENV=testing
APP_KEY=base64:Natpx7RqFiwbXb9bpT3oVcXW6T9Y6VET1STSm6Eh00M=
APP_DEBUG=true
APP_URL=http://localhost

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4
BROADCAST_CONNECTION=null
CACHE_STORE=array

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pilot_lms_testing
DB_USERNAME=pilot
DB_PASSWORD=pilot_secret
DB_URL=

MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
